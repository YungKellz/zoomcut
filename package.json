{
  "name": "zoomcut",
  "version": "0.1.0",
  "description": "Free, open-source screen recorder and demo editor: cuts, timed text, smooth follow-cursor zoom, cursor highlight, MP4/GIF export with full palette control.",
  "main": "./out/main/index.js",
  "license": "MIT",
  "author": "Andrey Nazarenko",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/YungKellz/zoomcut.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "dist": "electron-vite build && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.47.0",
    "mediabunny": "^1.58.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uiohook-napi": "^1.5.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.1"
  }
}
